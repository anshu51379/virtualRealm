{
  "name": "virtual-realm",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend",
    "frontend/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w @virtual-realm/web\"",
    "demo": "concurrently -k -n api,web \"npm run demo -w backend\" \"npm run dev -w @virtual-realm/web\"",
    "build": "npm run build -w @virtual-realm/web",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "test:e2e": "playwright test",
    "check:frontend-deploy": "node scripts/check-frontend-deploy.mjs",
    "seed": "npm run seed -w backend",
    "setup": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vercel/nft": "^1.11.0",
    "@vercel/routing-utils": "^6.6.0",
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
